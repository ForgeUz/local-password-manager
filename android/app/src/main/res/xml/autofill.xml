<?xml version="1.0" encoding="utf-8"?>
<!-- v5 D.2: AutofillService configuration. Declares the fields the service
     can fill (username/password) and the trusted web domains via Digital
     Asset Links. The service only launches the vault app; it never holds
     credentials (zero-trust). -->
<autofill-service>
    <!-- The service fills username + password fields. -->
    <field id="username" />
    <field id="current-password" />

    <!-- Digital Asset Links: the vault app is trusted for these domains.
         The assetlinks.json on each domain must list this app's package
         fingerprint. A look-alike app is rejected. -->
    <trusted-domains>
        <domain>example.com</domain>
        <domain>vault.example.com</domain>
    </trusted-domains>
</autofill-service>